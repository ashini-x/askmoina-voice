{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "brvin-test-client",
  "main": "workers/brvin-test-client/src/index.ts",
  "compatibility_date": "2026-10-09",
  "workers_dev": true,
  "observability": {
    "enabled": true
  },
  "vars": {
    "ENVIRONMENT": "test",
    "BRVIN_CONNECTOR_TIMEOUT_MS": "15000"
  },
  "services": [
    {
      "binding": "BRVIN_SERVICE",
      "service": "brvin-service",
      "entrypoint": "BrvinRetrievalApi",
      "props": {
        "applicationEnvironmentId": "c107de4c-c380-4ccd-be70-0047dd18b095"
      }
    }
  ]
}
