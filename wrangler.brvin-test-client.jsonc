{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "brvin-test-client",
  "main": "workers/brvin-test-client/src/index.ts",
  "compatibility_date": "2026-10-09",
  "workers_dev": true,
  "observability": {
    "enabled": true
  },
  "vars": {
    "ENVIRONMENT": "test",
    "BRVIN_CONNECTOR_TIMEOUT_MS": "15000"
  },
  // BRVIN_TEST_ACCESS_TOKEN is installed as a Worker secret by the admin connection step}
