{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "askmoina-tts-prototype",
  "main": "src/tts-prototype-worker.ts",
  "compatibility_date": "2026-10-09",
  "workers_dev": true,
  "assets": {
    "directory": "./public/",
    "binding": "ASSETS",
    "run_worker_first": ["/", "/tts-prototype", "/tts-prototype.html", "/api/*"]
  },
  "observability": { "enabled": true },
  "vars": {
    "APP_VERSION": "prototype-0.1.0",
    "ENVIRONMENT": "prototype",
    "GEMINI_MODEL": "gemini-3.8-flash",
    "GEMINI_LOCATION": "global",
    "GCP_PROJECT_ID": "project-90db7be4-619f-4ed7-89b",
    "TTS_PROTOTYPE_ENABLED": "true",
    "TTS_PROTOTYPE_VOICE_ID": "voice_6f4c602c-c79d-4a54-9bb1-c1549aab9c05"
  },
  "secrets": {
    "required": [
      "GCP_SERVICE_ACCOUNT_JSON",
      "TTS_PROTOTYPE_ACCESS_TOKEN"
    ]
  }
}
