# Placeholders only. Never commit real secrets.
# Store the full JSON file as a Cloudflare Worker Secret named GCP_SERVICE_ACCOUNT_JSON.
GCP_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"replace-with-project-id","private_key_id":"replace-with-key-id","private_key":"-----BEGIN PRIVATE KEY-----\\nREPLACE_WITH_PRIVATE_KEY\\n-----END PRIVATE KEY-----\\n","client_email":"replace-with-service-account-email","token_uri":"https://oauth2.googleapis.com/token"}
ADMIN_DASHBOARD_USER=admin
ADMIN_DASHBOARD_PASSWORD=replace-with-local-password
ADMIN_SESSION_SECRET=replace-with-random-development-secret

# Optional passkey overrides; otherwise derive RP ID/origin from the request.
# WEBAUTHN_RP_ID=askmoina-voice.thenewtongs.workers.dev
# WEBAUTHN_ORIGIN=https://askmoina-voice.thenewtongs.workers.dev
# Optional separate pepper for HMAC-hashing phone identities.
# AUTH_IDENTITY_PEPPER=replace-with-a-random-secret
# Required for SMS OTP using Twilio Verify; keep these in Cloudflare Worker Secrets.
# TWILIO_ACCOUNT_SID=ACXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
# TWILIO_AUTH_TOKEN=replace-with-twilio-auth-token
# TWILIO_VERIFY_SERVICE_SID=VAXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
