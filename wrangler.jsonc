{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "askmoina-voice",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-09",
  "workers_dev": true,
  "assets": {
    "directory": "./public/",
    "binding": "ASSETS",
    "run_worker_first": [
      "/",
      "/index.html",
      "/api/*",
      "/voice-lab",
      "/voice-lab.html",
      "/copilot",
      "/copilot.html",
      "/copilot.js",
      "/copilot.css",
      "/transcript-merge.js",
      "/login",
      "/login.html",
      "/account",
      "/account.html",
      "/auth.js",
      "/site-chrome.css",
      "/askmoina-bird-64.png",
      "/askmoina-bird-mark.png",
      "/askmoina-bird-final.png",
      "/admin",
      "/admin/*",
      "/admin.js",
      "/admin-login.js",
      "/vault",
      "/vault/",
      "/vault.js",
      "/continuity.js",
      "/app.js",
      "/session-ui.js"
    ]
  },
  "observability": {
    "enabled": true
  },
  "vars": {
    "APP_VERSION": "0.4.59",
    "ENVIRONMENT": "production",
    "ADMIN_DASHBOARD_USER": "admin",
    "GEMINI_MODEL": "gemini-3.8-live",
    "LIVE_VOICE_NAME": "Leda",
    "LIVE_VOICE_ID": "voice_6f4c602c-c79d-4a54-9bb1-c1549aab9c05",
    "GEMINI_LOCATION": "us-central1",
    "GCP_PROJECT_ID": "project-90db7be4-619f-4ed7-89b",
    "ANALYTICS_RAW_RETENTION_DAYS": "30"
  },
  "secrets": {
    "required": [
      "GCP_SERVICE_ACCOUNT_JSON",
      "ADMIN_DASHBOARD_PASSWORD",
      "ADMIN_SESSION_SECRET"
    ]
  },
  "triggers": {
    "crons": [
      "17 * * * *"
    ]
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "USER_STATE",
        "class_name": "UserState"
      },
      {
        "name": "LIVE_SESSION_RELAY",
        "class_name": "LiveSessionRelay"
      }
    ]
  },
  "exports": {
    "UserState": {
      "type": "durable-object",
      "storage": "sqlite"
    },
    "LiveSessionRelay": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "askmoina-prod",
      "database_id": "21b82a94-ce17-4a57-8741-3b9d46aef33f"
    }
  ],
  "queues": {
    "producers": [
      {
        "binding": "BACKGROUND_QUEUE",
        "queue": "askmoina-background-prod"
      }
    ],
    "consumers": [
      {
        "queue": "askmoina-background-prod",
        "max_batch_size": 10,
        "max_batch_timeout": 5,
        "max_retries": 5,
        "dead_letter_queue": "askmoina-background-dlq",
        "retry_delay": 15,
        "max_concurrency": 10
      }
    ]
  },
  "previews": {
    "vars": {
      "APP_VERSION": "0.4.55-preview",
      "ENVIRONMENT": "preview",
      "ADMIN_DASHBOARD_USER": "preview-admin",
      "GEMINI_MODEL": "gemini-3.8-live",
      "LIVE_VOICE_NAME": "Leda",
      "LIVE_VOICE_ID": "voice_6f4c602c-c79d-4a54-9bb1-c1549aab9c05",
      "GEMINI_LOCATION": "us-central1",
      "GCP_PROJECT_ID": "askmoina-preview",
      "ANALYTICS_RAW_RETENTION_DAYS": "30"
    },
    "durable_objects": {
      "bindings": [
        {
          "name": "USER_STATE",
          "class_name": "UserState"
        },
        {
          "name": "LIVE_SESSION_RELAY",
          "class_name": "LiveSessionRelay"
        }
      ]
    },
    "d1_databases": [
      {
        "binding": "DB",
        "database_name": "askmoina-preview",
        "database_id": "43673f49-e099-46a5-b35b-e975a6f4984c"
      }
    ],
    "queues": {
      "producers": [
        {
          "binding": "BACKGROUND_QUEUE",
          "queue": "askmoina-background-preview"
        }
      ]
    }
  }
}
